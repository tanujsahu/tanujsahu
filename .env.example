# Public site URL used for metadata, Open Graph, sitemap, and robots.
# On Vercel this can be https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key. Email is sent only when both this key and CONTACT_FROM_EMAIL are set.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend.
# Example after domain verification: "Tanuj Sahu <portfolio@yourdomain.com>"
# The Resend sandbox sender (onboarding@resend.dev) can only deliver to the
# email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# Inbox that receives portfolio messages.
CONTACT_TO_EMAIL=tanujsahu09@gmail.com
